<Window x:Class="CarrotTuningLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Carrot 설정 시뮬레이터" Width="1580" Height="980" MinWidth="1150" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Malgun Gothic" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8DEE8"/><Setter Property="Foreground" Value="#223049"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#D8DEE8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#ECF0F6"/><Setter Property="Foreground" Value="#52627A"/><Setter Property="Padding" Value="9,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="MinHeight" Value="76"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E6F4F0"/><Setter Property="Foreground" Value="#17273B"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#162A32" Padding="24,14"><DockPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Foreground="#80D6BA" Text="WINDOWS · 오프라인 설정 실험실" FontSize="12"/><TextBlock x:Name="VersionText" Foreground="#B9C8CE" FontSize="11" Margin="0,7,0,0"/></StackPanel><StackPanel><TextBlock Text="Carrot 설정 시뮬레이터" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="설정을 나란히 바꾸고, 적용 조건과 설정 간 관계를 읽어보세요." Foreground="#B9C8CE" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
  <StackPanel Grid.Row="1" Margin="18,14,18,10">
   <WrapPanel><Button Content="기준값 가져오기" Click="ImportBaseline"/><Button Content="프로필 저장" Click="SaveProfile"/>
      <Button Content="HUD 프로필 내보내기" Click="ExportPortableProfile" Margin="5,0" Padding="8,5"/><Button Content="프로필 불러오기" Click="LoadProfile"/><Button Content="종합 설명 내보내기" Click="ExportReport"/><Button Content="기준값 → A·B" Click="ResetBoth"/><Button Content="A → B 복사" Click="CopyAtoB"/><TextBlock x:Name="BaselineLabel" VerticalAlignment="Center" Foreground="#69758B" Margin="5,0,0,0"/></WrapPanel>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Search" TextChanged="FilterChanged" ToolTip="설정명·파라미터·설명 검색" AutomationProperties.Name="설정 검색"/>
    <ComboBox x:Name="Category" Grid.Column="1" Margin="10,0" SelectionChanged="FilterChanged" AutomationProperties.Name="설정 분류"/>
    <CheckBox x:Name="ChangedOnly" Grid.Column="2" Content="변경만" VerticalAlignment="Center" Margin="0,0,16,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock Text="속도 " VerticalAlignment="Center"/><TextBox x:Name="Speed" Text="50" Width="55" TextChanged="ContextChanged" AutomationProperties.Name="분석 속도"/><TextBlock Text=" km/h  " VerticalAlignment="Center"/></StackPanel>
    <ComboBox x:Name="Gap" Grid.Column="4" Width="110" Margin="0,0,10,0" SelectionChanged="ContextChanged" AutomationProperties.Name="차간거리 단계"><ComboBoxItem Content="차간거리 1"/><ComboBoxItem Content="차간거리 2"/><ComboBoxItem Content="차간거리 3"/><ComboBoxItem Content="차간거리 4"/></ComboBox>
    <ComboBox x:Name="Situation" Grid.Column="5" Width="140" SelectionChanged="ContextChanged" AutomationProperties.Name="분석 장면"><ComboBoxItem Content="앞차 접근·감속"/><ComboBoxItem Content="정차·재출발"/><ComboBoxItem Content="고속 정속 추종"/><ComboBoxItem Content="커브·측방 여유"/></ComboBox>
   </Grid>
  </StackPanel>
  <Grid Grid.Row="2" Margin="18,0,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock x:Name="CountText" DockPanel.Dock="Top" Margin="12,10" FontWeight="SemiBold"/>
    <DataGrid x:Name="SettingsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F4" BorderThickness="0" Background="White" RowBackground="White" SelectionMode="Single" IsReadOnly="True" EnableRowVirtualization="True" SelectionChanged="SelectedSetting">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="설정 / 설명" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Name}" FontSize="10" Foreground="#6C7A8E" Margin="0,3"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" MaxHeight="44" Foreground="#66748A" ToolTip="행을 선택하면 오른쪽에서 전체 설명을 볼 수 있습니다."/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="기준" Binding="{Binding Baseline}" Width="55"/>
      <DataGridTemplateColumn Header="시험안 A" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding AText, UpdateSourceTrigger=PropertyChanged}" Background="#EDF6FC" AutomationProperties.Name="{Binding Name,StringFormat=시험안 A {0}}" ToolTip="{Binding Range}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="시험안 B" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding BText, UpdateSourceTrigger=PropertyChanged}" Background="#FFF4E7" AutomationProperties.Name="{Binding Name,StringFormat=시험안 B {0}}" ToolTip="{Binding Range}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="B 기준 조건" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding State}" ToolTip="{Binding Conditions}" TextWrapping="Wrap" FontSize="11" Foreground="#377563"/><TextBlock Text="{Binding Error}" Foreground="#BE3434"/><TextBlock Text="{Binding Delta}" Foreground="#BD7022" FontSize="10"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="10"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="설정 조합의 종합 설명" FontSize="17" FontWeight="Bold" Margin="15,14"/>
     <TabControl x:Name="SummaryTabs" BorderThickness="0" Background="White" Margin="8,0,8,8"><TabItem Header="시험안 A"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SummaryA" Margin="8,12"/></ScrollViewer></TabItem><TabItem Header="시험안 B"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SummaryB" Margin="8,12"/></ScrollViewer></TabItem><TabItem Header="A ↔ B 차이"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DifferenceText" TextWrapping="Wrap" Margin="10,14" LineHeight="22"/></ScrollViewer></TabItem><TabItem Header="동작 안내"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10"><TextBlock Text="속도 변화에 따른 설정 차이" FontSize="16" FontWeight="Bold"/><TextBlock Text="개념 애니메이션 · 같은 속도에서의 같은 속도 기준 거리와 가속표 상한 비교입니다. 실제 출발 지연·감속 시점·차량 궤적을 예측하지 않습니다." TextWrapping="Wrap" Foreground="#69758B" Margin="0,8"/><Canvas x:Name="AnimationCanvas" Height="295" Background="#F2F5F8" ClipToBounds="True"/><TextBlock x:Name="AnimationLabel" TextWrapping="Wrap" Margin="0,12" LineHeight="22"/><TextBlock Text="도로 흐름과 간격의 상대 축척은 개념 표시입니다. 앞차 아이콘의 거리는 같은 속도 앞차 기준 거리를 도식화하며, MPC 목표거리나 실차 거리가 아닙니다. 인식·환경 조건이 없는 측방 이동은 재현하지 않습니다." TextWrapping="Wrap" FontSize="11" Foreground="#72818B" LineHeight="18"/></StackPanel></ScrollViewer></TabItem></TabControl>
    </DockPanel></Border>
    <Border Grid.Row="2" Background="#E9F0F0" BorderBrush="#D7E2E1" BorderThickness="1" CornerRadius="8"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="선택한 설정 자세히" FontSize="15" FontWeight="Bold" Foreground="#285B50"/><TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,6"/><TextBlock x:Name="DetailRange" Foreground="#66748A" TextWrapping="Wrap"/><TextBlock x:Name="DetailState" Foreground="#326B5C" TextWrapping="Wrap" LineHeight="20"/><TextBlock x:Name="DetailText" TextWrapping="Wrap" LineHeight="22" Margin="0,10"/><TextBlock x:Name="DetailSource" Foreground="#72818B" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusText" Background="#E5EAF0" Foreground="#536077" Padding="18,6" Text="PC 미리보기 전용 · 차량 연결·설정 전송 없음 · 실차 궤적/안전성 판정 도구 아님"/>
 </Grid>
</Window>
