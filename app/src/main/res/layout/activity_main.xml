<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical: the WebView sits ABOVE the button bar (not overlapping it),
     so neither the HUD card nor the full settings page is covered. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#11161B"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/archiveStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:textColor="#9EDDC6"
            android:textSize="11sp"
            android:text="자동 보관 대기" />
        <Button
            android:id="@+id/btnArchiveSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="자동 기록·PC 전송" />
        <Button
            android:id="@+id/btnExportRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="기록 내보내기" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#11161B"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="@string/btn_overlay" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="@string/btn_settings" />

        <Button
            android:id="@+id/btnDevices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="@string/btn_devices" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:text="@string/btn_reload" />
    </LinearLayout>
</LinearLayout>
